{
  "consumer": {
    "name": "inventory-frontend"
  },
  "interactions": [
    {
      "description": "a Cave envelope for saurce wallet route",
      "providerState": "saurce Cave is healthy",
      "request": {
        "body": {
          "payload": {
            "user_id": "u1"
          },
          "reply_mode": "sync_http",
          "route": "saurce:wallet/balance",
          "schema_version": "2.0",
          "trace_id": "trace-wallet"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.payload.user_id": {
            "match": "type"
          },
          "$.body.trace_id": {
            "match": "type"
          }
        },
        "method": "POST",
        "path": "/cave/route"
      },
      "response": {
        "body": {
          "echoed_route": "saurce:wallet/balance",
          "ok": true,
          "service": "saurce"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.echoed_route": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
      "description": "a message-first Cave envelope for investment_mode_enable",
