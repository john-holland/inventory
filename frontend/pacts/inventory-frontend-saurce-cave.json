    {
      "description": "a message-first Cave envelope for wallet_list",
      "providerState": "saurce Cave is healthy",
      "request": {
        "body": {
          "message": "wallet_list",
          "payload": {},
          "reply_mode": "sync_http",
          "schema_version": "2.0",
          "service": "saurce",
          "trace_id": "trace-wallet-list"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.trace_id": {
            "match": "type"
          }
        },
        "method": "POST",
        "path": "/cave/route"
      },
      "response": {
        "body": {
          "ok": true,
          "service": "saurce",
          "trace_id": "trace-wallet-list",
          "wallets": [
            {
              "balance": 100,
              "id": "wallet_1"
            }
          ]
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.trace_id": {
            "match": "type"
          },
          "$.body.wallets": {
            "match": "type",
            "min": 1
          },
          "$.body.wallets[*].balance": {
            "match": "type"
          },
          "$.body.wallets[*].id": {
            "match": "type"
          }
        },
        "status": 200
      }
    },
    {
