            "reason": "Needs CSR follow-up",
            "status": "open"
          },
          "trace_id": "trace-ticket"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.queue_item.category": {
            "match": "type"
          },
          "$.body.queue_item.priority": {
            "match": "type"
          },
          "$.body.queue_item.severity": {
            "match": "type"
          },
          "$.body.queue_item.ticketId": {
            "match": "type"
          },
          "$.body.ticket.cabinId": {
            "match": "type"
          },
          "$.body.ticket.id": {
            "match": "type"
          },
          "$.body.ticket.priority": {
            "match": "type"
          },
          "$.body.ticket.reason": {
            "match": "type"
          },
          "$.body.ticket.status": {
            "match": "type"
          },
          "$.body.trace_id": {
            "match": "type"
          }
        },
        "status": 200
      }
