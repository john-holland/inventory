          },
          "reply_mode": "sync_http",
          "schema_version": "2.0",
          "service": "saurce",
          "trace_id": "trace-ticket"
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "$.body.payload.cabin_id": {
            "match": "type"
          },
          "$.body.payload.priority": {
            "match": "type"
          },
          "$.body.payload.reason": {
