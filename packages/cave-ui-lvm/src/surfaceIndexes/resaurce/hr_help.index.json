{
  "schema_version": "tome-surface-index/1",
  "service": "resaurce",
  "surface": "hr_help",
  "machineId": "inventory:hrHelpUi",
  "initial": "idle",
  "states": [
    "idle",
    "loading",
    "ready",
    "awaiting_presence",
    "error"
  ],
  "views": [
    "HrIdleView",
    "HrLoadingView",
    "HrReadyView",
    "PresenceSignInView",
    "HrErrorView"
  ],
  "messages": [
    "request_hr_help",
    "list_available_employees",
    "create_chat_room",
    "send_chat_message",
    "list_chat_messages"
  ],
  "messages_map": {
    "request_hr_help": "hr/help/request",
    "list_available_employees": "hr/employees/available",
    "create_chat_room": "hr/chat/room/create",
    "send_chat_message": "hr/chat/message/send",
    "list_chat_messages": "hr/chat/messages/list"
  },
  "subMachines": [],
  "state_middleware": [
    "trace",
    "presence",
    "delegation",
    "robotCopy",
    "caveDbSnapshot",
    "log"
  ],
  "views_map": {
    "HrIdleView": {
      "module": "documents/hr/IdleView"
    },
    "HrLoadingView": {
      "module": "documents/hr/LoadingView"
    },
    "HrReadyView": {
      "module": "documents/hr/ReadyView"
    },
    "HrErrorView": {
      "module": "documents/hr/ErrorView"
    },
    "PresenceSignInView": {
      "module": "presence/SignInView"
    }
  },
  "lvm": {
    "machines": [
      {
        "id": "inventory:hrHelpUi",
        "initial": "idle",
        "states": {
          "idle": {
            "view": "HrIdleView"
          },
          "loading": {
            "view": "HrLoadingView",
            "on_enter": {
              "message": "request_hr_help"
            }
          },
          "ready": {
            "view": "HrReadyView"
          },
          "awaiting_presence": {
            "view": "PresenceSignInView",
            "requires_presence": true
          },
          "error": {
            "view": "HrErrorView"
          }
        }
      }
    ]
  }
}