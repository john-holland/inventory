{
  "schema_version": "tome-surface-index/1",
  "service": "resaurce",
  "surface": "legal_review",
  "machineId": "inventory:legalReviewUi",
  "initial": "idle",
  "states": [
    "idle",
    "loading",
    "ready",
    "generating",
    "error"
  ],
  "views": [
    "LegalIdleView",
    "LegalLoadingView",
    "LegalReadyView",
    "LegalGeneratingView",
    "LegalErrorView"
  ],
  "messages": [
    "legal_documents_list",
    "legal_document_enqueue"
  ],
  "messages_map": {
    "legal_documents_list": "legal/documents/list",
    "legal_document_enqueue": "legal/document/enqueue"
  },
  "subMachines": [],
  "sub_machines": {},
  "state_middleware": [
    "trace",
    "presence",
    "delegation",
    "robotCopy",
    "caveDbSnapshot",
    "log"
  ],
  "views_map": {
    "LegalIdleView": {
      "module": "documents/legal/IdleView"
    },
    "LegalLoadingView": {
      "module": "documents/legal/LoadingView"
    },
    "LegalReadyView": {
      "module": "documents/legal/ReadyView"
    },
    "LegalGeneratingView": {
      "module": "documents/legal/GeneratingView"
    },
    "LegalErrorView": {
      "module": "documents/legal/ErrorView"
    }
  },
  "lvm": {
    "machines": [
      {
        "id": "inventory:legalReviewUi",
        "initial": "idle",
        "states": {
          "idle": {
            "view": "LegalIdleView"
          },
          "loading": {
            "view": "LegalLoadingView",
            "on_enter": {
              "message": "legal_documents_list"
            }
          },
          "ready": {
            "view": "LegalReadyView"
          },
          "generating": {
            "view": "LegalGeneratingView",
            "on_enter": {
              "message": "legal_document_enqueue"
            }
          },
          "error": {
            "view": "LegalErrorView"
          }
        }
      }
    ]
  }
}