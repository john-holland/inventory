{
  "schema_version": "tome-surface-index/1",
  "service": "saurce",
  "surface": "investment",
  "machineId": "inventory:investmentUi",
  "initial": "idle",
  "states": [
    "idle",
    "loading",
    "ready",
    "submitting",
    "awaiting_presence",
    "error"
  ],
  "views": [
    "InvestmentIdleView",
    "InvestmentLoadingView",
    "InvestmentReadyView",
    "InvestmentSubmittingView",
    "PresenceSignInView",
    "InvestmentErrorView"
  ],
  "messages": [
    "investment_eligibility",
    "investment_mode_enable",
    "wallet_hold_apply"
  ],
  "messages_map": {
    "investment_eligibility": "investment/eligibility/evaluate",
    "investment_mode_enable": "investment/mode/enable",
    "wallet_hold_apply": "wallet/hold/apply"
  },
  "subMachines": [],
  "sub_machines": {},
  "state_middleware": [
    "trace",
    "presence",
    "delegation",
    "robotCopy",
    "caveDbSnapshot",
    "log"
  ],
  "views_map": {
    "InvestmentIdleView": {
      "module": "item/investment/IdleView"
    },
    "InvestmentLoadingView": {
      "module": "item/investment/LoadingView"
    },
    "InvestmentReadyView": {
      "module": "item/investment/ReadyView"
    },
    "InvestmentSubmittingView": {
      "module": "item/investment/SubmittingView"
    },
    "InvestmentErrorView": {
      "module": "item/investment/ErrorView"
    },
    "PresenceSignInView": {
      "module": "presence/SignInView"
    }
  },
  "lvm": {
    "machines": [
      {
        "id": "inventory:investmentUi",
        "initial": "idle",
        "states": {
          "idle": {
            "view": "InvestmentIdleView"
          },
          "loading": {
            "view": "InvestmentLoadingView",
            "on_enter": {
              "message": "investment_eligibility"
            }
          },
          "ready": {
            "view": "InvestmentReadyView"
          },
          "submitting": {
            "view": "InvestmentSubmittingView",
            "on_enter": {
              "message": "investment_mode_enable"
            }
          },
          "awaiting_presence": {
            "view": "PresenceSignInView",
            "requires_presence": true
          },
          "error": {
            "view": "InvestmentErrorView"
          }
        }
      }
    ]
  }
}