{
  "schema_version": "tome-surface-index/1",
  "service": "saurce",
  "surface": "cabin_session",
  "machineId": "inventory:cabinSessionUi",
  "initial": "idle",
  "states": [
    "idle",
    "loading",
    "ready",
    "wizardActive",
    "submitting",
    "error"
  ],
  "views": [
    "CabinIdleView",
    "CabinLoadingView",
    "CabinReadyView",
    "CabinWizardShellView",
    "CabinSubmittingView",
    "CabinErrorView",
    "WizardBasicView",
    "WizardUsersView",
    "WizardAirbnbView",
    "WizardConfirmView"
  ],
  "messages": [
    "review_queue_list",
    "review_cabin_submit",
    "review_ticket_create"
  ],
  "messages_map": {
    "review_queue_list": "review/queue/list",
    "review_cabin_submit": "review/cabin/submit",
    "review_ticket_create": "review/ticket/create"
  },
  "subMachines": [
    "createWizard"
  ],
  "sub_machines": {
    "createWizard": {
      "id": "inventory:cabinCreateWizard",
      "initial": "basic",
      "states": {
        "basic": {
          "view": "WizardBasicView"
        },
        "users": {
          "view": "WizardUsersView"
        },
        "airbnb": {
          "view": "WizardAirbnbView"
        },
        "confirm": {
          "view": "WizardConfirmView"
        }
      }
    }
  },
  "capsule": "subMachineRouter",
  "state_middleware": [
    "trace",
    "presence",
    "delegation",
    "robotCopy",
    "caveDbSnapshot",
    "log",
    "capsule"
  ],
  "views_map": {
    "CabinIdleView": {
      "module": "cabin/session/IdleView"
    },
    "CabinLoadingView": {
      "module": "cabin/session/LoadingView"
    },
    "CabinReadyView": {
      "module": "cabin/session/ReadyView"
    },
    "CabinWizardShellView": {
      "module": "cabin/session/WizardShellView"
    },
    "CabinSubmittingView": {
      "module": "cabin/session/SubmittingView"
    },
    "CabinErrorView": {
      "module": "cabin/session/ErrorView"
    },
    "WizardBasicView": {
      "module": "cabin/session/wizard/BasicView"
    },
    "WizardUsersView": {
      "module": "cabin/session/wizard/UsersView"
    },
    "WizardAirbnbView": {
      "module": "cabin/session/wizard/AirbnbView"
    },
    "WizardConfirmView": {
      "module": "cabin/session/wizard/ConfirmView"
    }
  },
  "lvm": {
    "machines": [
      {
        "id": "inventory:cabinSessionUi",
        "initial": "idle",
        "states": {
          "idle": {
            "view": "CabinIdleView"
          },
          "loading": {
            "view": "CabinLoadingView",
            "on_enter": {
              "message": "review_queue_list"
            }
          },
          "ready": {
            "view": "CabinReadyView"
          },
          "wizardActive": {
            "view": "CabinWizardShellView"
          },
          "submitting": {
            "view": "CabinSubmittingView"
          },
          "error": {
            "view": "CabinErrorView"
          }
        }
      }
    ]
  }
}