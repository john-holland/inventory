{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resaurce.local/schemas/resaurce-frontend-tome-v1.json",
  "title": "Resaurce frontend static federation slice",
  "type": "object",
  "required": ["tome_semver", "service", "surfaces"],
  "properties": {
    "tome_semver": { "type": "string" },
    "service": { "const": "resaurce" },
    "assets_base": { "type": "string" },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "federation": {
      "type": "object",
      "properties": {
        "remote_name": { "type": "string" },
        "remote_entry_path": { "type": "string", "pattern": "^/" },
        "exposed_module": { "type": "string" }
      }
    }
  },
  "additionalProperties": false
}
